{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    }
  ],
  "rules": {
    // Oxlint 1.81 surfaced these react-plugin rules on pre-existing code.
    // Warnings until the refactors land: #345.
    "react/refs": "warn",
    "react/immutability": "warn",
    "react/set-state-in-effect": "warn",
    "react/globals": "warn",
    "react/preserve-manual-memoization": "warn",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": ["error", { "allowInTypeGuards": true }],
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop-effect/no-service-constructor-imports": "error"
  },
  "overrides": [
    // An override REPLACES a rule's config; it does not merge it. A second
    // override matching src/plugins/** would silently kill the kit ban below,
    // so every plugin-facing no-restricted-imports pattern lives in THIS block.
    // src/components/** gets its own block only because the globs are disjoint.
    {
      "files": ["src/plugins/**/*.ts", "src/plugins/**/*.tsx"],
      "excludeFiles": ["src/plugins/kit.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/components/ui/*", "**/components/ui/*"],
                "message": "Import blessed UI from '@/plugins/kit' (the curated Lane-A shadcn surface, ADR 0031), not directly from components/ui."
              },
              {
                "group": ["**/data/collection", "@/data/collection"],
                "importNames": ["nodesCollection"],
                "message": "Read live nodes through getLiveNodes() (@/data/live-nodes). nodesCollection is ready-and-empty while the Lunora flag is ON (ADR 0058)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/**/*.ts", "src/components/**/*.tsx"],
      "excludeFiles": [
        "src/components/delete-confirm-dialog.tsx",
        "src/components/opml-import-dialog.tsx",
        "src/components/markdown-paste.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/data/collection", "@/data/collection"],
                "importNames": ["nodesCollection"],
                "message": "Read live nodes through getLiveNodes() (@/data/live-nodes). nodesCollection is ready-and-empty while the Lunora flag is ON (ADR 0058). The three excluded files WRITE to it behind an isLunoraSyncEnabled() gate."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/routes/**/*.ts", "src/routes/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/data/collection", "@/data/collection"],
                "importNames": ["nodesCollection"],
                "message": "Read live nodes through getLiveNodes() (@/data/live-nodes), and wait for sync with whenNodesSyncReady() -- NOT nodesCollection.toArrayWhenReady(), which resolves instantly while the Lunora flag is ON (ADR 0058)."
              }
            ]
          }
        ]
      }
    }
  ],
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "landing/src/routeTree.gen.ts",
    "lunora/_generated/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".commandcode/**",
    ".cursor/**",
    ".humanlayer/**",
    ".impeccable/**",
    ".shipstudio/**",
    ".superset/**",
    ".zed/**",
    "tools/oxlint/anti-slop/**"
  ]
}
