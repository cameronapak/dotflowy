{
  "name": "dotflowy",
  "version": "1.14.0",
  "private": true,
  "description": "A local-first outline editor built with TanStack Start and TanStack DB.",
  "license": "O'Saasy",
  "type": "module",
  "imports": {
    "#lunora/*": "./lunora/*"
  },
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "bootstrap": "bun scripts/bootstrap.ts",
    "dev": "bun scripts/dev.ts",
    "dev:web": "vite dev",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "gen:icons": "bun run scripts/gen-icons.ts",
    "build:cf": "vite build && cp dist/client/_shell.html dist/client/index.html",
    "preview": "vite preview",
    "cf:dev": "bun scripts/cf-dev.ts",
    "seed:user": "bun scripts/seed-user.ts",
    "comp:dev-plan": "bun scripts/comp-dev-plan.ts",
    "mint:mcp-token": "bun scripts/mint-mcp-token.ts",
    "invite": "bun scripts/invite.ts",
    "lunora:retire": "bun scripts/lunora-retirement.ts",
    "announce": "bun scripts/announce.ts",
    "deploy": "bun run build:cf && wrangler deploy",
    "gen:og": "bun scripts/gen-og.ts",
    "release": "bun scripts/release.ts",
    "release:publish": "bun scripts/release.ts --publish",
    "release:ship": "git checkout main && git pull --ff-only && bun run release && git push --follow-tags && bun run release:publish",
    "db:migrate:local": "wrangler d1 migrations apply dotflowy-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply dotflowy-db --remote",
    "lint": "oxlint src worker",
    "lint:fix": "oxlint src worker --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "check:docs": "bun scripts/check-doc-links.ts",
    "test": "bun test -- ./src ./worker",
    "test:e2e": "playwright test",
    "test:e2e:serial": "playwright test --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "effect:src": "opensrc path Effect-TS/effect-smol",
    "effect:src:update": "opensrc remove Effect-TS/effect-smol && opensrc fetch Effect-TS/effect-smol",
    "lunora:codegen": "lunora codegen"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/stripe": "^1.6.33",
    "@floating-ui/react-dom": "^2.1.9",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@lunora/db": "1.0.0-alpha.113",
    "@lunora/ratelimit": "1.0.0-alpha.63",
    "@lunora/react": "1.0.0-alpha.115",
    "@rgrove/parse-xml": "^5.0.0",
    "@sentry/cloudflare": "^10.74.0",
    "@sentry/react": "^10.74.0",
    "@tanstack/db": "^0.9.2",
    "@tanstack/offline-transactions": "^1.0.56",
    "@tanstack/query-core": "^5.103.0",
    "@tanstack/query-db-collection": "^1.2.15",
    "@tanstack/react-db": "^0.4.1",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.54",
    "@tanstack/react-virtual": "^3.14.13",
    "@xstate/react": "7.0.0-alpha.1",
    "better-auth": "^1.6.33",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cnfast": "^0.2.0",
    "date-fns": "^4.4.0",
    "effect": "4.0.0-rc.115",
    "fuse.js": "^7.5.0",
    "grab-bcv": "^0.1.7",
    "lucide-react": "^1.46.0",
    "lunorash": "1.0.0-alpha.259",
    "motion": "^13.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tw-animate-css": "^1.4.0",
    "xstate": "6.0.0-alpha.12"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/workers-types": "^5.20260916.1",
    "@oxlint/plugins": "1.83.0",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "opensrc": "^0.7.3",
    "oxfmt": "^0.68.0",
    "oxlint": "1.83.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.132.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{css,json,jsonc,md,yaml,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
