{
  // Unit tests run under Vitest (script: `test`; ADR 0061). They live
  // co-located as src/**/*.test.ts(x) (node pool) and worker/**/*.test.ts
  // (workerd pool) and are EXCLUDED from the app tsconfig so test imports
  // never leak into the browser app's typecheck. This file typechecks them
  // on their own, mirroring typecheck:worker.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // `cloudflare:test` / `cloudflare:workers` module types for the workerd
    // pool (src tests import from "vitest" explicitly, needing no ambient).
    "types": ["@cloudflare/vitest-plugin/types"],
    "noEmit": true
  },
  // vite-env.d.ts carries the `virtual:dotflowy-changelog` module declaration
  // (ADR 0046) that this config's `include` override would otherwise drop.
  "include": [
    "src/vite-env.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "worker/**/*.test.ts",
    "worker/test/*.ts"
  ],
  "exclude": []
}
