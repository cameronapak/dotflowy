/*
 * Dotflowy (ADR 0065): the credential-free Apple Shortcut template.
 *
 * Authoring and build:
 *   bun scripts/shortcut.ts --build    compile this source into the private unsigned input
 *   bun scripts/shortcut.ts --sign     macOS only: Apple `shortcuts sign`
 *
 * Cherri (https://cherrilang.org) owns the action schemas, so the template can
 * only contain actions Shortcuts actually knows. Hand-written plist identifiers
 * were how the first template shipped an unrecognized Match Text action and a
 * "Generate UUID" action that does not exist as a built-in.
 *
 * The capture key is an import question, never a real credential in this file
 * or in the compiled template. Self-hosters edit the request URL manually.
 */

#define name Dotflowy
#define glyph list
#define color lightblue
#define inputs text, url
#define from sharesheet, search, spotlight

#include 'actions/calendar'
#include 'actions/text'
#include 'actions/web'

#question key "Paste your Dotflowy capture key. Your installed shortcut contains this key." "PASTE_CAPTURE_KEY_DURING_IMPORT"

/* A shared text/URL wins; otherwise ask, with keyboard dictation available. */
const captureText = if ShortcutInput {
	text("{ShortcutInput}")
} else {
	prompt('What do you want to add to today? You can type or use keyboard dictation.')
}

/* One capture, one bullet: blank input creates nothing, including no scaffold. */
const nonblank = matchText('\S', "{captureText}")
if nonblank {
	/* No built-in action generates a UUID, so the attempt ID is a UUID-shaped
	 * opaque per-invocation token. Shortcuts clamps Random Number to a signed
	 * 32-bit integer, so join two six-digit numbers for the 12-digit tail. */
	const attemptFirst = randomNumber(100000, 999999)
	const attemptLast = randomNumber(100000, 999999)
	const attemptId = "00000000-0000-4000-8000-{attemptFirst}{attemptLast}"
	const captureDate = formatTimestamp(CurrentDate, 'Custom', 'None', 'yyyy-MM-dd')
	const captureKey = text(key)
	const response = jsonRequest('https://app.dotflowy.com/api/capture', 'POST', {
		"attemptId": "{attemptId}",
		"date": "{captureDate}",
		"text": "{captureText}"
	}, {
		"Authorization": "Bearer {captureKey}",
		"Content-Type": "application/json"
	})
	const saved = getValue(response, 'saved')
	const nodeId = getValue(response, 'nodeId')
	const dailyNoteId = getValue(response, 'dailyNoteId')
	const receiptDate = getValue(response, 'date')
	const receipt = "{nodeId}\n{dailyNoteId}\n{receiptDate}"
	const receiptMatch = matchText('(?s)^.+\n.+\n\d{4}-\d{2}-\d{2}$', receipt)
	/* A Boolean renders as localized text ("Yes" on English macOS), not "true".
	 * Check its numeric value only after the other receipt fields are present. */
	const receiptSaved = if receiptMatch {
		number(saved)
	} else {
		text('0')
	}
	if receiptSaved.number == 1 {
		showNotification('Added one bullet to today\'s note.', 'Saved to Dotflowy')
	} else {
		const errorCode = getValue(response, 'error')
		const errorMessage = getValue(response, 'message')
		show("Capture failed ({errorCode}): {errorMessage}")
	}
}
